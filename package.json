{
  "name": "@hanhanawa/wear-m3e-vue",
  "version": "0.1.1",
  "description": "Vue components for round Wear Material 3 Expressive layouts",
  "author": "hanhanawa",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanhanawa/wear-m3e-vue.git"
  },
  "bugs": {
    "url": "https://github.com/Hanhanawa/wear-m3e-vue/issues"
  },
  "homepage": "https://github.com/Hanhanawa/wear-m3e-vue#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "SOURCES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wear-m3e-vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "check": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "vite examples/watch --host 127.0.0.1 --config examples/watch/vite.config.ts --mode demo --port 5173 --strictPort",
    "catalog": "vite examples/watch --host 127.0.0.1 --config examples/watch/vite.config.ts --mode catalog --port 5174 --strictPort",
    "example": "vite examples/watch --host 127.0.0.1 --config examples/watch/vite.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:catalog": "node tests/catalog-browser.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
